{
  "description": "feature-dev: lint a SPEC or PLAN in .feature-dev/features/ after every write or edit; agent-bash-guard audits the Bash calls of read-only agents (AGENT_BASH_GUARD=audit|enforce|off); the Features pane mod",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/scripts/lint_artifact.py",
              "--hook"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/agent-bash-guard.sh",
              "${CLAUDE_PLUGIN_ROOT}"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modules": [
    "./register.tsx"
  ]
}
